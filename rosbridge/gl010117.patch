+static std::mutex access_mutex;
+static std::condition_variable access_changed;
+static unsigned long access_generation = 0;
+static MONITORING_ACCESS_CONTROL last_access = MONITORING_ACCESS_CONTROL_LOSS;
+
+static void record_access(MONITORING_ACCESS_CONTROL event) {
+    {
+        std::lock_guard<std::mutex> lock(access_mutex);
+        last_access = event;
+        ++access_generation;
+    }
+    access_changed.notify_all();
+}
+static std::atomic<bool> link_lost{false};
+static std::atomic<bool> tp_ready{false};
+
+bool sdk_has_authority() {
+    std::lock_guard<std::mutex> lock(access_mutex);
+    return !link_lost && last_access == MONITORING_ACCESS_CONTROL_GRANT;
+}
+
+bool sdk_reclaim_access(std::string& message) {
+    static std::mutex requests;
+    std::unique_lock<std::mutex> request(requests, std::try_to_lock);
+    if (!request) { message = "다른 회수 요청을 처리 중입니다."; return false; }
+    if (link_lost || !tp_ready) { message = "SDK 연결 또는 초기화가 완료되지 않았습니다."; return false; }
+
+    std::unique_lock<std::mutex> lock(access_mutex);
+    if (last_access == MONITORING_ACCESS_CONTROL_GRANT) {
+        message = "드라이버가 이미 제어권을 보유하고 있습니다."; return true;
+    }
+    const auto before = access_generation;
+    lock.unlock();  // The SDK may deliver its callback during the request.
+    const auto state = Drfl.GetRobotState();
+    if (state != STATE_SAFE_OFF && state != STATE_STANDBY) {
+        message = "로봇이 SAFE_OFF 또는 STANDBY일 때 회수할 수 있습니다."; return false;
+    }
+    if (link_lost || !Drfl.manage_access_control(MANAGE_ACCESS_CONTROL_FORCE_REQUEST)) {
+        message = "SDK가 강제 요청을 전송하지 못했습니다."; return false;
+    }
+
+    lock.lock();
+    if (!access_changed.wait_for(lock, std::chrono::seconds(10), [&] { return access_generation != before || link_lost; })) {
+        message = "10초 안에 응답이 없어 회수 결과를 확인할 수 없습니다."; return false;
+    }
+    if (link_lost) { message = "SDK 연결이 끊겨 회수 결과를 확인할 수 없습니다."; return false; }
+    if (last_access == MONITORING_ACCESS_CONTROL_GRANT) {
+        message = "드라이버가 제어권을 회수했습니다 (GRANT)."; return true;
+    }
+    message = last_access == MONITORING_ACCESS_CONTROL_DENY
+        ? "제어기가 회수 요청을 거절했습니다 (DENY)." : "드라이버가 제어권을 잃었습니다 (LOSS).";
+    return false;
+}
+
 bool g_bHommingCompleted = FALSE;
 
