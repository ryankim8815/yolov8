# 통합 실행(bash scripts/stack.sh up coreml)은 프로젝트 루트의 .env를 읽습니다. 처음에는 이 파일을 .env로 복사하세요.
# Mac 서버만 scripts/start.sh로 실행할 때는 적용할 변수를 터미널에서 export하세요.

# 객체 탐지에 사용할 백엔드입니다. coreml은 Core ML, mps는 Mac GPU, cpu는 CPU를 사용합니다.
# scripts/start.sh로 실행할 때는 첫 번째 인자로 선택합니다(예: bash scripts/start.sh coreml). 생략하면 mps입니다.
YOLO_BACKEND=coreml

# 사용할 카메라의 장치 번호입니다. 0은 첫 번째 카메라이며, 여러 대를 연결한 경우 다른 번호를 선택할 수 있습니다.
YOLO_CAMERA_INDEX=0
# macOS 12+에서 RealSense 깊이 센서 USB 접근에 관리자 인증이 필요하면 1로 설정합니다.
# 영상 서버는 일반 권한으로 유지하고 센서 작업자만 macOS 인증창으로 실행합니다.
# YOLO_REALSENSE_PRIVILEGED=1
# 이 모드는 Xcode Command Line Tools와 네이티브 SDK(brew install librealsense)를 사용합니다.
# SDK가 다른 경로에 설치돼 있으면 해당 설치 접두 경로를 지정합니다.
# YOLO_REALSENSE_PREFIX=/opt/homebrew
# 1(기본값)이면 서버 시작과 함께 카메라를 켭니다. 0이면 대시보드에서 필요할 때 켤 수 있습니다.
# YOLO_CAMERA_AUTOSTART=1
# 카메라에 요청할 영상의 가로 해상도(픽셀)입니다.
YOLO_WIDTH=1280
# 카메라에 요청할 영상의 세로 해상도(픽셀)입니다.
YOLO_HEIGHT=720
# 카메라에 요청할 초당 프레임 수(FPS)입니다. 실제 촬영 속도는 장치가 지원하는 모드에 따라 달라집니다.
YOLO_CAMERA_FPS=30

# 탐지 모델에 입력할 정사각형 이미지의 한 변 길이(픽셀)입니다. 32의 양의 배수여야 하며 Core ML 모델의 입력 크기와 일치해야 합니다.
YOLO_IMGSZ=640
# 탐지 결과를 채택할 최소 신뢰도입니다(0 초과, 1 미만). 높일수록 확신도가 낮은 후보를 더 많이 제외합니다.
YOLO_CONF=0.25
# 같은 종류의 탐지 상자끼리 겹칠 때 중복을 제거하는 기준(IoU)입니다(0 초과, 1 미만). 낮출수록 겹친 상자를 더 많이 제거합니다.
YOLO_IOU=0.45
# 한 프레임에서 반환할 최대 탐지 객체 수입니다.
YOLO_MAX_DET=100

# 대시보드 미리보기를 초당 몇 프레임까지 갱신할지 정합니다(FPS).
YOLO_PREVIEW_FPS=15
# 미리보기 JPEG의 압축 품질입니다(1~100). 높일수록 화질이 좋아지고 전송량도 대체로 늘어납니다.
YOLO_JPEG_QUALITY=80
# 탐지 결과와 미리보기 프레임을 최신으로 취급하는 시간(초)입니다. 이보다 오래된 미리보기 프레임은 건너뜁니다.
YOLO_STALE_SECONDS=1
# MJPEG 또는 WebSocket으로 데이터를 한 번 보낼 때 기다리는 최대 시간(초)입니다.
YOLO_SEND_TIMEOUT=5

# Chrome 패킹·로봇 음성. 최신 데스크톱 Chrome, localhost 또는 HTTPS가 필요합니다.
# Chrome 온라인 STT는 음성이 Google로 전송될 수 있습니다. 인터넷 연결과 마이크 권한이 필요합니다.
YOLO_VOICE_ENABLED=1
# 이전 설정 호환용. Chrome은 낭독 중 인식을 멈추므로 1도 적용하지 않습니다.
YOLO_VOICE_BARGE_IN=0

# 사진, SQLite DB, 데이터셋 스냅샷과 학습 결과를 저장할 폴더입니다. 생략하면 프로젝트의 state/를 사용합니다.
# YOLO_STATE_DIR=/Users/ryankim/Documents/robotics/yolov8/state
# 서버 시작 시 불러올 탐지 모델 경로입니다. 지정하면 해당 백엔드에서 마지막으로 선택한 모델보다 우선합니다.
# mps·cpu는 PyTorch 모델(.pt), coreml은 Core ML 모델(.mlpackage) 경로를 사용하세요.
# YOLO_MODEL_PATH=/absolute/path/to/model.pt

# 두산 E0509 · Mac 유선 LAN(en7: 110.120.1.11/24) → 제어기
# docker compose up -d --build --wait 실행 후 http://localhost:8080/robot 에 접속하세요.
# 하드웨어 드라이버는 docker compose --profile hardware up -d --build 로 별도 기동합니다.
ROBOT_IP=110.120.1.56
# ROBOT_IP=110.120.1.63
ROBOT_PORT=12345
# 읽기 전용 관절 발행자(joint-monitor)가 사용하는 E0509 Modbus TCP 포트입니다.
ROBOT_MODBUS_PORT=502
# 이 E0509의 LAN 장치 검색 응답은 GF02100300 (V2.10.3)입니다. SDK 빌드에는 주 버전 2만 지정합니다.
ROBOT_DRCF_MAJOR=2
# 이 Mac의 AX88179B 유선 어댑터입니다. scripts/check_robot_lan.py가 유선 포트 점검에 사용합니다.
ROBOT_LAN_INTERFACE=en7
# mac-sdk: 127.0.0.1:8011의 Mac SDK 세션에서 제어권 회수와 저장한 자세 이동을 처리합니다.
ROBOT_ACCESS_BACKEND=ros

# 로컬 브리지 설정입니다. 기본 Compose에서는 rosbridge 서비스 이름으로 연결하고, host 모드에서는 루프백으로 연결합니다.
# 별도 ROS PC를 사용할 경우 그 PC의 실제 IP를 지정하세요.
# ROBOT_BRIDGE_BIND_IP는 Docker가 Mac에 공개할 rosbridge 포트의 바인드 주소입니다.
ROBOT_ROS_PC_IP=127.0.0.1
ROBOT_BRIDGE_BIND_IP=127.0.0.1
ROBOT_ROSBRIDGE_PORT=9090
# 브리지, 모니터와 드라이버에서 같은 ROS 도메인 및 네임스페이스를 사용합니다.
ROS_DOMAIN_ID=0
# /dsr01/joint_states를 구독합니다. 실제 토픽이 /dsr02/joint_states라면 dsr02로 변경하세요.
ROBOT_NAMESPACE=dsr01
# 이 시간(초) 동안 새 관절 메시지가 없으면 수신 지연으로 표시합니다.
ROBOT_STALE_SECONDS=3
# 자세를 보관하는 Compose 볼륨. docker compose down 이후에도 유지됩니다.
ROBOT_STATE_STORAGE=robot-state
# 호스트 폴더를 직접 공유할 경우 ROBOT_STATE_STORAGE=./state/robot
# Compose가 기본 사용하는 공식 소스입니다. 로컬 경로로 재정의할 때는 아래 커밋의 체크아웃을 사용하세요.
# DOOSAN_SDK_CONTEXT=https://github.com/DoosanRobotics/API-DRFL.git#ddf59fad8bbd71d8aa318bf5f00349913b33f334
# DOOSAN_DRIVER_CONTEXT=https://github.com/DoosanRobotics/doosan-robot2.git#1634069af9cf4b9d446f97aeff2bc0f37dfc6f7d
# DOOSAN_MSGS_CONTEXT=https://github.com/DoosanRobotics/doosan-robot2.git#dade65d3a99dd8b29d8eca3689a4ead74f228d77:dsr_msgs2
