# 통합 실행(bash scripts/stack.sh up coreml)은 프로젝트 루트의 .env를 읽습니다. 처음에는 이 파일을 .env로 복사하세요.
# Mac 서버만 scripts/start.sh로 실행할 때는 적용할 변수를 터미널에서 export하세요.

# 객체 탐지에 사용할 백엔드입니다. coreml은 Core ML, mps는 Mac GPU, cpu는 CPU를 사용합니다.
# scripts/start.sh로 실행할 때는 첫 번째 인자로 선택합니다(예: bash scripts/start.sh coreml). 생략하면 mps입니다.
YOLO_BACKEND=coreml

# 사용할 카메라의 장치 번호입니다. 0은 첫 번째 카메라이며, 여러 대를 연결한 경우 다른 번호를 선택할 수 있습니다.
YOLO_CAMERA_INDEX=0
# 1(기본값)이면 서버 시작과 함께 카메라를 켭니다. 0이면 대시보드에서 필요할 때 켤 수 있습니다.
# YOLO_CAMERA_AUTOSTART=1
# 카메라에 요청할 영상의 가로 해상도(픽셀)입니다.
YOLO_WIDTH=1280
# 카메라에 요청할 영상의 세로 해상도(픽셀)입니다.
YOLO_HEIGHT=720
# 카메라에 요청할 초당 프레임 수(FPS)입니다. 실제 촬영 속도는 장치가 지원하는 모드에 따라 달라집니다.
YOLO_CAMERA_FPS=30

# 탐지 모델에 입력할 정사각형 이미지의 한 변 길이(픽셀)입니다. 32의 양의 배수여야 하며 Core ML 모델의 입력 크기와 일치해야 합니다.
YOLO_IMGSZ=640
# 탐지 결과를 채택할 최소 신뢰도입니다(0 초과, 1 미만). 높일수록 확신도가 낮은 후보를 더 많이 제외합니다.
YOLO_CONF=0.25
# 같은 종류의 탐지 상자끼리 겹칠 때 중복을 제거하는 기준(IoU)입니다(0 초과, 1 미만). 낮출수록 겹친 상자를 더 많이 제거합니다.
YOLO_IOU=0.45
# 한 프레임에서 반환할 최대 탐지 객체 수입니다.
YOLO_MAX_DET=100

# 대시보드 미리보기를 초당 몇 프레임까지 갱신할지 정합니다(FPS).
YOLO_PREVIEW_FPS=15
# 미리보기 JPEG의 압축 품질입니다(1~100). 높일수록 화질이 좋아지고 전송량도 대체로 늘어납니다.
YOLO_JPEG_QUALITY=80
# 탐지 결과와 미리보기 프레임을 최신으로 취급하는 시간(초)입니다. 이보다 오래된 미리보기 프레임은 건너뜁니다.
YOLO_STALE_SECONDS=1
# MJPEG 또는 WebSocket으로 데이터를 한 번 보낼 때 기다리는 최대 시간(초)입니다.
YOLO_SEND_TIMEOUT=5

# Mac 패킹 음성 대화. 처음 사용할 때는 bash scripts/build_voice.sh로 Swift 프로그램을 빌드하세요.
# 0(기본값)이면 음성 대화를 끄고, 1이면 한국어 음성 인식과 Yuna 응답을 사용합니다.
YOLO_VOICE_ENABLED=1
# 음성 대화가 켜져 있을 때, 0(기본값)이면 Yuna가 답변을 마친 뒤 다음 말을 듣습니다.
# 1이면 답변 도중에도 말할 수 있습니다. Yuna가 낭독을 멈추고 방금 말한 명령을 처리합니다.
YOLO_VOICE_BARGE_IN=0

# 사진, SQLite DB, 데이터셋 스냅샷과 학습 결과를 저장할 폴더입니다. 생략하면 프로젝트의 state/를 사용합니다.
# YOLO_STATE_DIR=/Users/ryankim/Documents/robotics/yolov8/state
# 서버 시작 시 불러올 탐지 모델 경로입니다. 지정하면 해당 백엔드에서 마지막으로 선택한 모델보다 우선합니다.
# mps·cpu는 PyTorch 모델(.pt), coreml은 Core ML 모델(.mlpackage) 경로를 사용하세요.
# YOLO_MODEL_PATH=/absolute/path/to/model.pt
