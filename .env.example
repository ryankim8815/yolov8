# Native server configuration. Export these variables; the launch scripts do not auto-source this file.
YOLO_BACKEND=coreml
YOLO_CAMERA_INDEX=0
YOLO_WIDTH=1280
YOLO_HEIGHT=720
YOLO_CAMERA_FPS=30
YOLO_IMGSZ=640
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_MAX_DET=100
YOLO_PREVIEW_FPS=15
YOLO_JPEG_QUALITY=80
YOLO_STALE_SECONDS=1
YOLO_SEND_TIMEOUT=5

# Optional: local photos, SQLite metadata, dataset snapshots and training artifacts.
# YOLO_STATE_DIR=/Users/ryankim/Documents/robotics/yolov8/state
# Explicit model path takes precedence over the remembered model for this backend.
# YOLO_MODEL_PATH=/absolute/path/to/model.pt
